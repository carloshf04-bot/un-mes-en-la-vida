      {
        "dia": 1,
        "capitulo": "La luz que no se apaga",
        "texto": "Primero de noviembre de mil ochocientos noventa. Me llamo Manuel, tengo treinta y cuatro años, y soy torrero de faros del Estado.",
        "fondo": {
          "lugar": "mar",
          "hora": "amanecer",
          "clima": "niebla",
          "props": [
            {
              "tipo": "faro",
              "x": -1.35
