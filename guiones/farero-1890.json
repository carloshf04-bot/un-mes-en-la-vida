        "personajes": [
          {
            "quien": "inspector",
            "x": 0.4,
            "accion": "escribir",
            "habla": false,
            "mirar": -1
          },
          {
            "quien": "manuel",
            "x": -0.4,
            "accion": "hablar",
            "emocion": "cansado"
          }
        ]
      },
      {
        "dia": 18,
        "texto": "Todo estaba en orden. Cada encendido, cada revisión, cada hora. La luz de Vilán no falló. Pero eso no me consolaba.",
        "insercion": {
          "tipo": "cita",
          "frase": "Encendido a las cinco y diez. Mar muy gruesa. Viento duro del suroeste. Luz en perfecto estado.",
          "firma": "Libro de servicio"
        }
      },
      {
        "dia": 19,
        "texto": "Los tres supervivientes se marcharon a Inglaterra. Antes de irse, Gould me estrechó la mano en el muelle. No dijo nada. No hacía falta.",
        "fondo": {
          "lugar": "mar",
          "hora": "dia",
          "props": [
            {
              "tipo": "velero",
              "x": 1.2
            },
            {
              "tipo": "barril",
              "x": -1.4
            }
          ]
        },
        "personajes": [
          {
            "quien": "gould",
            "x": 0.3,
            "accion": "saludar",
            "mirar": -1,
            "habla": false,
            "sale": "der"
          },
          {
            "quien": "manuel",
            "x": -0.4,
            "accion": "saludar",
            "emocion": "triste",
            "mirar": 1
          }
        ]
      },
      {
        "dia": 20,
        "texto": "Más tarde supimos que la Marina inglesa quiso dar las gracias al pueblo. Al cura le regalaron una escopeta, y a Camariñas, un barómetro. Para que nadie volviera a sorprenderse por una tormenta.",
        "insercion": {
          "tipo": "objetos",
          "titulo": "Regalos de la Marina británica",
          "items": [
            {
              "icono": "🌡️",
              "nombre": "Un barómetro para el pueblo"
            },
            {
              "icono": "🎯",
              "nombre": "Una escopeta para el cura"
            },
            {
              "icono": "📜",
              "nombre": "Una carta de gratitud"
            }
          ]
        }
      },
      {
        "dia": 21,
        "texto": "Xan ya no habla de ser marinero. Ahora dice que quiere ser torrero, como yo. Carmen me mira y no sé si está orgullosa o asustada.",
        "fondo": {
          "lugar": "interior",
          "pared": "madera",
          "hora": "atardecer",
          "props": [
            "chimenea",
            {
              "tipo": "mesa",
              "x": 1.3
            }
          ]
        },
        "personajes": [
          {
            "quien": "xan",
            "x": 0.1,
