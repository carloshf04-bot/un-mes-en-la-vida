            "x": 0.6,
            "accion": "trabajar",
            "objeto": "🧽",
            "emocion": "feliz",
            "habla": false
          }
        ]
      },
      {
        "dia": 6,
        "texto": "Desde arriba se ve todo. Los cabos, los islotes, la espuma rompiendo sobre las piedras. Xan me pregunta por qué los barcos se acercan tanto. Le digo la verdad. Porque a veces no ven nada.",
        "camara": "subir",
