          {
            "quien": "manuel",
            "x": -0.4,
            "accion": "pensar"
          }
        ],
        "camara": "cerca"
      },
      {
        "dia": 6,
        "texto": "Esa tarde Xan me pide subir conmigo a la linterna. Le enseño a limpiar la lente con la gamuza, en círculos, sin dejar ni una huella.",
        "fondo": {
          "lugar": "mar",
          "hora": "atardecer",
          "props": [
            {
              "tipo": "faro",
              "x": -1.35
            }
