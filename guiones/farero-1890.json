            "quien": "manuel",
            "x": 0,
            "accion": "trabajar",
            "objeto": "✂️",
            "emocion": "cansado"
          }
        ],
        "camara": "cerca"
      },
      {
        "dia": 3,
        "texto": "Esto es lo que llevo encima cada noche de guardia.",
        "insercion": {
          "tipo": "objetos",
          "titulo": "Mi noche de guardia",
          "items": [
            {
              "icono": "🫙",
