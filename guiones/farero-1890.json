            {
              "tipo": "🌼",
              "x": 0.6,
              "escala": 0.5
            }
          ]
        },
        "personajes": [
          {
            "quien": "manuel",
            "x": -0.2,
            "accion": "triste",
            "emocion": "triste"
          }
        ],
        "camara": "paneo"
      },
      {
        "dia": 30,
        "texto": "Treinta de noviembre. Treinta noches de guardia. Doscientas cuarenta subidas a la linterna. Ni una sola vez se apagó la luz.",
        "insercion": {
          "tipo": "dato",
          "valor": "240",
          "etiqueta": "subidas a la linterna este mes",
          "icono": "🪜"
        }
      },
      {
        "dia": 30,
        "texto": "Lo que no sabía entonces es que mi carta no cayó en saco roto. Seis años después, en mil ochocientos noventa y seis, se levantó en Cabo Vilán una torre nueva.",
        "fondo": {
          "lugar": "mar",
          "hora": "noche",
          "clima": "despejado",
          "props": [
            {
              "tipo": "faro",
              "x": -1.2,
