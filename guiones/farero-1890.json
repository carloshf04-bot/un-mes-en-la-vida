          ]
        },
        "personajes": [
          {
            "quien": "manuel",
            "x": 0.3,
            "accion": "escribir",
            "emocion": "cansado"
          }
        ]
      },
      {
        "dia": 4,
        "texto": "Por la mañana, cuando por fin puedo dormir un poco, Carmen ya lleva horas trabajando. Ella es palilleira. Hace encaje con bolillos, como casi todas las mujeres de Camariñas.",
        "fondo": {
          "lugar": "interior",
          "pared": "madera",
          "hora": "dia",
          "props": [
            "estanteria",
            {
              "tipo": "mesa",
